#include <windows.h>

1 ICON "app.ico"
2 ICON "tray.ico"
1 24 "app.manifest"

1 VERSIONINFO
FILEVERSION     0,2,3,0
PRODUCTVERSION  0,2,3,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "080404B0"
    BEGIN
      VALUE "CompanyName",      "Lume"
      VALUE "FileDescription",  "Lume Launcher"
      VALUE "FileVersion",      "0.2.3.0"
      VALUE "InternalName",     "Lume"
      VALUE "LegalCopyright",   "Copyright (c) 2026 Lume"
      VALUE "OriginalFilename", "Lume.exe"
      VALUE "ProductName",      "Lume"
      VALUE "ProductVersion",   "0.2.3.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x804, 1200
  END
END
