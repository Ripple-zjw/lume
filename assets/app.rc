#include <windows.h>

1 24 "app.manifest"

1 VERSIONINFO
FILEVERSION     0,1,0,0
PRODUCTVERSION  0,1,0,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "080404B0"
    BEGIN
      VALUE "CompanyName",      "eTools"
      VALUE "FileDescription",  "eTools 启动器"
      VALUE "FileVersion",      "0.1.0.0"
      VALUE "InternalName",     "eTools"
      VALUE "LegalCopyright",   "Copyright (c) 2026 eTools"
      VALUE "OriginalFilename", "eTools.exe"
      VALUE "ProductName",      "eTools"
      VALUE "ProductVersion",   "0.1.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x804, 1200
  END
END
